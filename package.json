{
  "name": "openpos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/shared"
  ],
  "scripts": {
    "dev": "bun src/cli.ts",
    "dev:cli": "bun src/cli.ts",
    "dev:tui": "cd src && bun tui.ts",
    "dev:web": "bun src/cli.ts --web:dev",
    "dev:web:api": "npx vite --config vite.config.ts",
    "dev:web:server": "bun src/modules/web/server.ts",
    "build:web": "vite build",
    "start:web": "bun src/modules/web/server.ts",
    "typecheck": "tsc --noEmit",
    "seed": "bun src/db/seed.ts",
    "import": "bun src/db/import-csv.ts",
    "build": "echo 'Use tsx src/cli.ts'",
    "reinstall": "rm -rf node_modules bun.lock && npm install"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "bun-types": "^1.3.12",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.23.0",
    "typescript": "^5.4.5",
    "vite": "^6.3.4"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.7.6",
    "ink": "^7.0.0",
    "ink-text-input": "^6.0.0",
    "lucide-react": "^0.474.0",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0",
    "recharts": "^2.15.3",
    "zustand": "^5.0.2"
  }
}
