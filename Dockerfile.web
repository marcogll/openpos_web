# Stage 1: Build
FROM oven/bun:latest AS builder

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

# Copy dependency files first
COPY package.json bun.lock* package-lock.json* ./
COPY src/shared/package.json ./src/shared/package.json
COPY src/shared/bun.lock* ./src/shared/

# Install dependencies
RUN bun install

# Copy source code and assets
COPY . .

# Build Vite frontend
RUN bunx vite build

# Stage 2: Runtime
FROM oven/bun:latest

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

# Copy built frontend
COPY --from=builder /app/dist/web ./dist/web

# Copy server and shared code
COPY --from=builder /app/src/modules/web ./src/modules/web
COPY --from=builder /app/src/shared ./src/shared
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./
COPY --from=builder /app/bun.lock* ./

# Copy assets
COPY --from=builder /app/assets ./assets
COPY --from=builder /app/config.json* ./

# Set environment
ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

CMD ["bun", "src/modules/web/server.ts"]
