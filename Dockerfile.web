# Stage 1: Build
FROM oven/bun:latest AS builder

WORKDIR /app

# Copy dependency files first
COPY package.json bun.lock* package-lock.json* ./

# Install dependencies
RUN bun install

# Copy source code and assets
COPY . .

# Build Vite frontend
RUN bunx vite build

# Stage 2: Runtime
FROM oven/bun:latest

WORKDIR /app

# Copy built frontend
COPY --from=builder /app/dist/web ./dist/web

# Copy server and shared code
COPY --from=builder /app/src/modules/web/server.ts ./src/modules/web/server.ts
COPY --from=builder /app/src/modules/web/routes ./src/modules/web/routes
COPY --from=builder /app/src/shared ./src/shared
COPY --from=builder /app/package.json ./
COPY --from=builder /app/bun.lock* ./

# Copy assets
COPY --from=builder /app/assets ./assets
COPY --from=builder /app/config.json* ./

# Install production dependencies only
RUN bun install --production

# Set environment
ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

CMD ["bun", "run", "src/modules/web/server.ts"]
